---
import '../styles/global.css';

const alternatives = [
  {
    id: "antigravity",
    name: "1. Google Antigravity IDE",
    type: "Desktop IDE (VS Code Fork)",
    tag: "Built-In & Active",
    models: "Gemini 3.5 / 3.8 Flash, Claude Models",
    strengths: "Autonomous Headless Browser testing (edge-light indicator), automatic self-correcting bug fixes, implementation plans.",
    setup: "Already running right now in your Antigravity workspace!",
    status: "active"
  },
  {
    id: "opencode",
    name: "2. OpenCode CLI (Zen Network)",
    type: "Terminal CLI (Matches Claude Code)",
    tag: "Open Source (17.1k+ ⭐)",
    models: "Minimax M3, Xiaomi MiMo V2.5, Nemotron-3 Ultra, DeepSeek-V4-Flash",
    strengths: "Autonomous filesystem scans, terminal-driven workflow identical to Claude Code, zero token cost via OpenCode Zen Free.",
    setup: "Installed globally: run `opencode` -> `/connect zen` -> pick model.",
    status: "ready"
  },
  {
    id: "blackbox",
    name: "3. Blackbox AI Extension",
    type: "IDE Sidebar Extension",
    tag: "2M+ Installs",
    models: "Kimi K2.6, MiniMax 2.7",
    strengths: "Sidebar AI assistant with auto-code edits, direct @filename referencing, fast completion.",
    setup: "Install in Antigravity via VS Code Marketplace -> select Kimi K2.6 -> Auto mode.",
    status: "setup-ready"
  },
  {
    id: "kilocode",
    name: "4. Kilocode AI Extension",
    type: "IDE Split-Screen Companion",
    tag: "1.1M+ Installs",
    models: "NVIDIA Nemotron-3 Ultra, Qwen 2.5 Coder",
    strengths: "Split-view workflow, Ask vs Code toggle, one-click Prompt Enhancer wand.",
    setup: "Install extension -> login with Google -> split editor into side panel.",
    status: "setup-ready"
  },
  {
    id: "openrouter",
    name: "5. OpenRouter Auto Router",
    type: "API Fallback Router",
    tag: "Failover Protection",
    models: "Rotating Free Models (Qwen 2.5 Coder, Kimi K2.6, Gemma)",
    strengths: "Automatically routes prompts across all available free models to bypass traffic rate limits.",
    setup: "In OpenCode: `/connect openrouter` -> enter free key -> `/model Auto Router`.",
    status: "ready"
  }
];

const skills = [
  { name: "astro", desc: "Astro components, pages, routing, and islands architecture", icon: "🚀" },
  { name: "tailwind-4-docs", desc: "Tailwind CSS v4 syntax, CSS-first config, @theme directives", icon: "🎨" },
  { name: "web-design-guidelines", desc: "Vercel-inspired typography, contrast, layout, and visual hierarchy", icon: "✨" }
];
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Claude Code Free Alternatives & Full Workflow (Antigravity)</title>
  </head>
  <body class="min-h-screen bg-[#09090b] text-[#fafafa] font-sans antialiased selection:bg-[#2563eb] selection:text-white">
    <!-- Top Banner -->
    <div class="border-b border-[#27272a] bg-[#121215]/80 backdrop-blur sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
          <span class="font-semibold text-sm tracking-tight text-white flex items-center gap-2">
            Antigravity <span class="text-xs text-zinc-500">/</span> Claude Code Free Stack
          </span>
        </div>
        <div class="flex items-center gap-4 text-xs font-mono text-zinc-400">
          <span class="px-2.5 py-1 rounded-full bg-zinc-800 border border-zinc-700 text-zinc-300">
            Node v24.13.1
          </span>
          <span class="px-2.5 py-1 rounded-full bg-zinc-800 border border-zinc-700 text-zinc-300">
            OpenCode v1.18.35
          </span>
        </div>
      </div>
    </div>

    <!-- Hero Section -->
    <main class="max-w-6xl mx-auto px-6 py-12">
      <header class="max-w-3xl mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium mb-4">
          ✓ Unlimited & Full Workflow Activated
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white mb-4 leading-tight">
          5 FREE Claude Code Alternatives
        </h1>
        <p class="text-lg text-zinc-400 leading-relaxed">
          Full agentic workflow running locally on Windows via Google Antigravity. Zero subscription costs, multi-model fallback, and Vercel-standard design stack.
        </p>
      </header>

      <!-- Active Universal Stack Info -->
      <section class="mb-12 p-6 rounded-2xl bg-zinc-900/60 border border-zinc-800">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
          <div>
            <h2 class="text-lg font-semibold text-white">Active Workflow Architecture</h2>
            <p class="text-sm text-zinc-400">All 3 agent skills and Vercel DESIGN.md are installed and linked to Antigravity.</p>
          </div>
          <div class="flex gap-2">
            <span class="px-3 py-1 rounded-md bg-zinc-800 border border-zinc-700 text-xs font-mono text-zinc-300">Astro 5</span>
            <span class="px-3 py-1 rounded-md bg-zinc-800 border border-zinc-700 text-xs font-mono text-zinc-300">Tailwind CSS v4</span>
            <span class="px-3 py-1 rounded-md bg-zinc-800 border border-zinc-700 text-xs font-mono text-zinc-300">DESIGN.md (Vercel)</span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {skills.map(s => (
            <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800 hover:border-zinc-700 transition-all">
              <div class="flex items-center gap-2 mb-2 font-mono text-sm text-emerald-400 font-semibold">
                <span>{s.icon}</span>
                <span>{s.name}</span>
              </div>
              <p class="text-xs text-zinc-400 leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Alternatives Grid -->
      <section class="mb-14">
        <h2 class="text-2xl font-bold text-white mb-6">The 5 Alternatives In Action</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {alternatives.map(item => (
            <div class="p-6 rounded-2xl bg-zinc-900/40 border border-zinc-800 hover:border-zinc-700 transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-start justify-between gap-4 mb-3">
                  <div>
                    <h3 class="text-lg font-bold text-white">{item.name}</h3>
                    <span class="text-xs text-zinc-500 font-mono">{item.type}</span>
                  </div>
                  <span class="px-2.5 py-1 text-[11px] font-mono rounded-full bg-zinc-800 border border-zinc-700 text-zinc-300">
                    {item.tag}
                  </span>
                </div>

                <div class="mb-4">
                  <div class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1">Key Free Models</div>
                  <div class="text-sm font-semibold text-zinc-200">{item.models}</div>
                </div>

                <div class="mb-4">
                  <div class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1">Primary Strength</div>
                  <p class="text-xs text-zinc-400 leading-relaxed">{item.strengths}</p>
                </div>
              </div>

              <div class="pt-4 border-t border-zinc-800/80">
                <div class="text-xs font-mono text-zinc-500 uppercase tracking-wider mb-1">Quick Action / Command</div>
                <div class="px-3 py-2 rounded-lg bg-zinc-950 font-mono text-xs text-zinc-300 border border-zinc-800/60 select-all">
                  {item.setup}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Quick Commands & Shortcuts Cheat Sheet -->
      <section class="p-6 rounded-2xl bg-zinc-900/50 border border-zinc-800">
        <h2 class="text-xl font-bold text-white mb-4">Command Center & Quick Reference</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-mono">
          <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800">
            <div class="text-zinc-400 mb-1">// Launch OpenCode CLI</div>
            <div class="text-emerald-400 font-bold mb-2">opencode</div>
            <div class="text-zinc-500">Connect to free Zen network: <code class="text-zinc-300">/connect zen</code></div>
            <div class="text-zinc-500">Switch model to Minimax M3: <code class="text-zinc-300">/model Minimax M3</code></div>
          </div>
          <div class="p-4 rounded-xl bg-zinc-950 border border-zinc-800">
            <div class="text-zinc-400 mb-1">// Antigravity Rules & Skills</div>
            <div class="text-emerald-400 font-bold mb-2">AGENTS.md & .geminirules</div>
            <div class="text-zinc-500">Auto-detected by Antigravity on every turn.</div>
            <div class="text-zinc-500">Guides UI to strictly follow <code class="text-zinc-300">DESIGN.md</code>.</div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
